# Port d'écoute de l'API (8081 par défaut)
PORT=8081
# Postgres de la plateforme (sans DB_HOST, l'API garde tout en mémoire : dev local uniquement)
DB_HOST=postgres.internal
DB_PORT=5432
DB_NAME=team27
DB_USER=postgres
DB_PASSWORD=
# Code d'accès de l'écran /accompagnante (vide = écran désactivé, l'API répond 503)
ACCOMPAGNANTE_CODE=
# 1 = écran accompagnante SANS authentification, comme le demande le PRD de la version de test
# (« Qui êtes-vous ? »). Données d'exemple uniquement : jamais avec de vraies participantes.
ACCOMPAGNANTE_ACCES_LIBRE=0
